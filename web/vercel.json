{
  "rewrites": [{ "source": "/((?!circuits/|art/|assets/|og\\.jpg).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/circuits/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, immutable" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
